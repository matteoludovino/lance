# Copy to apps/api/.env for local development.

# Pooled connection used by the running API (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://lance:lance@localhost:5439/lance"
# Direct connection used by `prisma migrate` (on Neon: the host without "-pooler"). Optional locally.
# DIRECT_DATABASE_URL=""

# Exact origins allowed to call the API and open the WebSocket, comma-separated.
WEB_ORIGINS="http://localhost:3030"
PORT=8040

# The web app's address, for links in emails.
WEB_URL="http://localhost:3030"
# Mailpit (npm run db:up) catches every email: http://localhost:8025. Unset: emails are only kept in the
# database (table sent_emails).
SMTP_URL="smtp://localhost:1025"

# Where browsers open the WebSocket (in production: wss://<the API's host>/ws).
PUBLIC_WS_URL="ws://localhost:8040/ws"

# Signs unsubscribe links. Required in production (32+ characters, e.g. `openssl rand -hex 32`);
# unset elsewhere, a fixed development value is used.
# SIGNING_SECRET=""
