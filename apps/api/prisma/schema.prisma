// Models arrive stage by stage; hand-written SQL (triggers, constraints, full-text) lives in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A demo visitor's private corner of the marketplace. Everything a visitor writes carries its id: they see
/// the seeded marketplace plus their own sandbox, never someone else's. Deleting it removes all of that.
model Sandbox {
  id           String        @id @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime      @db.Timestamptz(3)
  outboxEvents OutboxEvent[]

  @@index([expiresAt])
  @@map("sandboxes")
}

/// Domain events written in the same transaction as the change they describe, then handled by the
/// in-process scheduler (emails, delayed rules). A row is handled once: claimed with SKIP LOCKED, retried
/// with backoff on failure, given up after too many attempts.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(60)
  payload     Json
  sandboxId   String?   @db.Uuid
  sandbox     Sandbox?  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  dueAt       DateTime  @default(now()) @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([processedAt, failedAt, dueAt])
  @@map("outbox_events")
}
