// Models arrive stage by stage; hand-written SQL (triggers, constraints, full-text) lives in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A demo visitor's private corner of the marketplace. Everything a visitor writes carries its id: they see
/// the seeded marketplace plus their own sandbox, never someone else's. Deleting it removes all of that.
model Sandbox {
  id           String        @id @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime      @db.Timestamptz(3)
  outboxEvents OutboxEvent[]
  users        User[]
  sentEmails   SentEmail[]

  @@index([expiresAt])
  @@map("sandboxes")
}

/// Domain events written in the same transaction as the change they describe, then handled by the
/// in-process scheduler (emails, delayed rules). A row is handled once: claimed with SKIP LOCKED, retried
/// with backoff on failure, given up after too many attempts.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(60)
  payload     Json
  sandboxId   String?   @db.Uuid
  sandbox     Sandbox?  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  dueAt       DateTime  @default(now()) @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([processedAt, failedAt, dueAt])
  @@map("outbox_events")
}

enum Role {
  user
  admin
}

/// An account. One account can hire (client profile), work (freelancer profile) or both; which side the
/// interface shows is only a view, every authorization checks who owns the resource.
model User {
  id                      String             @id @db.Uuid
  /// Trimmed and lower-cased. Never sent to anyone but its owner.
  email                   String             @unique @db.VarChar(254)
  name                    String             @db.VarChar(60)
  /// Argon2id. Null: can't sign in with a password (seeded people, demo personas).
  passwordHash            String?
  role                    Role               @default(user)
  emailVerifiedAt         DateTime?          @db.Timestamptz(3)
  sandboxId               String?            @db.Uuid
  sandbox                 Sandbox?           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// Set by moderation: can't sign in, and disappears from every listing.
  suspendedAt             DateTime?          @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  sessions                Session[]
  emailTokens             EmailToken[]
  clientProfile           ClientProfile?
  freelancerProfile       FreelancerProfile?
  projects                Project[]
  proposals               Proposal[]
  clientContracts         Contract[]         @relation("ContractClient")
  freelancerContracts     Contract[]         @relation("ContractFreelancer")
  clientConversations     Conversation[]     @relation("ConversationClient")
  freelancerConversations Conversation[]     @relation("ConversationFreelancer")

  @@index([sandboxId])
  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id @db.Uuid
  tokenHash Bytes    @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

enum EmailTokenPurpose {
  verify_email
  reset_password
}

/// A link sent by email (verify the address, reset the password). Stored as SHA-256, used once.
model EmailToken {
  id        String            @id @db.Uuid
  tokenHash Bytes             @unique
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Emails kept instead of (or as well as) sent: every email when no SMTP server is configured, and
/// always for demo accounts, whose visitors read them in the app's "sent emails" box.
model SentEmail {
  id        String   @id @db.Uuid
  sandboxId String?  @db.Uuid
  sandbox   Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  to        String   @db.VarChar(254)
  kind      String   @db.VarChar(60)
  subject   String
  text      String
  html      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([sandboxId, createdAt])
  @@index([userId, createdAt])
  @@map("sent_emails")
}

/// The hiring side of an account.
model ClientProfile {
  userId    String    @id @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Copied from the user: everything a person writes carries its sandbox.
  sandboxId String?   @db.Uuid
  company   String?   @db.VarChar(80)
  about     String?
  city      String?   @db.VarChar(60)
  state     String?   @db.Char(2)
  /// Set by moderation: gone from listings and pages (its owner still sees it).
  hiddenAt  DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([sandboxId])
  @@map("client_profiles")
}

/// The working side of an account.
model FreelancerProfile {
  userId         String    @id @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxId      String?   @db.Uuid
  headline       String    @db.VarChar(80)
  bio            String
  category       String    @db.VarChar(40)
  skills         String[]
  /// Smallest project budget they take, in centavos.
  minBudgetCents BigInt
  available      Boolean   @default(true)
  city           String?   @db.VarChar(60)
  state          String?   @db.Char(2)
  hiddenAt       DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([sandboxId])
  @@map("freelancer_profiles")
}

enum ProjectStatus {
  draft
  open
  in_progress
  completed
  cancelled
}

/// What a client needs done, for a fixed price within a budget range. Rows written by demo visitors carry
/// their sandbox; they go away with the visitor's user (cascade), so no separate key to the sandbox.
model Project {
  id             String         @id @db.Uuid
  clientId       String         @db.Uuid
  client         User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sandboxId      String?        @db.Uuid
  title          String         @db.VarChar(100)
  description    String
  category       String         @db.VarChar(40)
  skills         String[]
  budgetMinCents BigInt
  budgetMaxCents BigInt
  status         ProjectStatus  @default(draft)
  publishedAt    DateTime?      @db.Timestamptz(3)
  closedAt       DateTime?      @db.Timestamptz(3)
  /// Set by moderation: gone from listings (its owner still sees it).
  hiddenAt       DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  proposals      Proposal[]
  contract       Contract?
  conversations  Conversation[]

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([clientId])
  @@map("projects")
}

enum ProposalStatus {
  submitted
  withdrawn
  declined
  accepted
}

/// A freelancer's offer for a project: one per freelancer and project (withdrawing and proposing again
/// reopens the same row). Every change bumps `version`, which accepting must name.
model Proposal {
  id           String         @id @db.Uuid
  projectId    String         @db.Uuid
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId String         @db.Uuid
  freelancer   User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  sandboxId    String?        @db.Uuid
  coverLetter  String
  deliveryDays Int
  /// [{ title, amountCents }]; priceCents is their sum.
  milestones   Json
  priceCents   BigInt
  status       ProposalStatus @default(submitted)
  version      Int            @default(1)
  submittedAt  DateTime       @db.Timestamptz(3)
  decidedAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  contract     Contract?

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
  @@map("proposals")
}

enum ContractStatus {
  active
  completed
  cancelled
}

enum MilestoneStatus {
  pending_funding
  funded
  submitted
  revision_requested
  approved
  disputed
  released
  refunded
  cancelled
}

/// The agreement made by accepting a proposal: at most one per project. The fee is copied in, so later
/// changes to the platform's fee never touch existing contracts. Funding and payment arrive in stage 4.
model Contract {
  id           String              @id @db.Uuid
  projectId    String              @unique @db.Uuid
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId   String              @unique @db.Uuid
  proposal     Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientId     String              @db.Uuid
  client       User                @relation("ContractClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String              @db.Uuid
  freelancer   User                @relation("ContractFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  sandboxId    String?             @db.Uuid
  priceCents   BigInt
  feeBps       Int
  status       ContractStatus      @default(active)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  milestones   ContractMilestone[]

  @@index([clientId])
  @@index([freelancerId])
  @@map("contracts")
}

model ContractMilestone {
  id          String          @id @db.Uuid
  contractId  String          @db.Uuid
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  position    Int
  title       String          @db.VarChar(80)
  amountCents BigInt
  status      MilestoneStatus @default(pending_funding)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([contractId, position])
  @@map("contract_milestones")
}

/// Client and freelancer talking about a project. It starts with the proposal (messages arrive in
/// stage 5): one per project and freelancer.
model Conversation {
  id           String   @id @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String   @db.Uuid
  client       User     @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String   @db.Uuid
  freelancer   User     @relation("ConversationFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  sandboxId    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, freelancerId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("conversations")
}
